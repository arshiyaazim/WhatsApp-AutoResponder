# Secrets are delivered as Docker secrets by compose.yaml, not as plaintext entries here.
# Local/non-Compose deployments may set the variables directly or set NAME_FILE to a protected file.
# Keep host .env files mode 0600; never commit values.

DATABASE_PATH=/data/ai_gateway.sqlite3

# Gemini primary: every key must name its Google Cloud project. Keys in one project share quota.
GEMINI_API_KEYS_JSON=[]
GEMINI_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Existing OpenAI variables remain supported as a secondary-provider compatibility path.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEYS_JSON=[]
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_OCR_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_API_KEYS_JSON=[]
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5
ANTHROPIC_OCR_MODEL=claude-sonnet-4-5
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5

# Optional custom chat-completions-compatible endpoints. Each key entry may specify provider_id.
CUSTOM_OPENAI_PROVIDERS_JSON=[]
CUSTOM_OPENAI_API_KEYS_JSON=[]
CUSTOM_OPENAI_API_KEY=

# Optional task-specific order. Defaults: Gemini -> OpenAI -> Anthropic -> local TF-IDF (text only).
AI_FALLBACK_ORDER_JSON=
AI_AUTOMATIC_FAILOVER=true

# Safety controls / optional price table (USD per million tokens). Unknown costs remain null.
REQUESTS_PER_MINUTE=20
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_PREFIX=ai-gateway
# Single-process development only. Compose overrides backend/url to shared Redis; production outside Compose must set RATE_LIMIT_BACKEND=redis and RATE_LIMIT_REDIS_URL_FILE to a protected Redis URL file.
AI_MAX_REQUESTS_PER_DAY=1000
AI_MAX_DAILY_SPEND_USD=
AI_MAX_REQUEST_SPEND_USD=
AI_MAX_IMAGE_BYTES=8388608
AI_MAX_CONCURRENT_UPLOADS=2
AI_UPLOAD_REQUEST_TIMEOUT_SECONDS=120
AI_MODEL_PRICING_JSON={}
