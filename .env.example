# Single non-secret configuration file for Docker Compose + FastAPI.
# Copy to .env, review every value, and never put API keys/tokens here.

# Immutable tag: the install guide sets this to release-<short-git-commit>; never reuse a tag.
AI_GATEWAY_IMAGE_TAG=
AI_GATEWAY_HOST_PORT=8000
# Human reference for the Nginx site; configure this in the existing reviewed HTTPS vhost.
AI_GATEWAY_DOMAIN=ai.example.com
RATE_LIMIT_KEY_PREFIX=whatsapp-ai

# Provider models and priority seed (applied only when the SQLite DB is first initialized).
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_OCR_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_OCR_MODEL=gpt-4.1-mini
OPENAI_VISION_MODEL=gpt-4.1-mini
ANTHROPIC_TEXT_MODEL=claude-sonnet-4-5
ANTHROPIC_OCR_MODEL=claude-sonnet-4-5
ANTHROPIC_VISION_MODEL=claude-sonnet-4-5
AI_FALLBACK_ORDER_JSON=
AI_AUTOMATIC_FAILOVER=true
# Optional custom HTTPS OpenAI-compatible provider definitions; keys stay in secrets/custom_openai_api_keys.json.
CUSTOM_OPENAI_PROVIDERS_JSON=[]

# Safety limits. Set both spend values to owner-approved USD amounts before production use.
REQUESTS_PER_MINUTE=20
AI_MAX_REQUESTS_PER_DAY=1000
AI_MAX_DAILY_SPEND_USD=
# Blank means reserve all remaining daily allowance per request; otherwise <= daily cap.
AI_MAX_REQUEST_SPEND_USD=
AI_MODEL_PRICING_JSON={}

# Upload/TMP consistency. Image size cannot exceed 8 MiB and worker count cannot exceed 2.
AI_MAX_IMAGE_BYTES=8388608
AI_MAX_CONCURRENT_UPLOADS=2
AI_UPLOAD_REQUEST_TIMEOUT_SECONDS=120

# Resource caps protect neighboring services; inspect VPS capacity before changing these.
AI_GATEWAY_MEMORY_LIMIT=768m
AI_GATEWAY_CPU_LIMIT=1.0
RATE_LIMIT_MEMORY_LIMIT=128m
RATE_LIMIT_CPU_LIMIT=0.5
